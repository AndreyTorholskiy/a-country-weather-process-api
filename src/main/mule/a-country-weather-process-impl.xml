<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp"
	xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/amqp http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd">
	<sub-flow name="publishCountrySingleQueue" doc:id="dff313e0-5293-49d6-944b-d0d763487835">
		<http:request doc:name="GET Countries" doc:id="2f0987c5-abf4-42ad-95f0-eec145c77555" config-ref="HTTP_Domain_Request_config" path="${http.requester.basePath}/countries" />
		<ee:transform doc:name="Random 3 Europe Country" doc:id="03663e66-59a7-4456-a1e1-34bf283e35ea">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
(payload orderBy ((item, index) -> random()))[0 to 2]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<foreach doc:name="For Each" doc:id="8c5ad987-4043-4da8-a20d-1961ab2572a9">
			<ee:transform doc:name="Prapare Country Data" doc:id="aab541b1-b4e8-4c58-94e5-fdabfdabec65">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	country: payload.name.common,
	region: payload.region,
	subregion: payload.subregion,
	currencies: payload.currencies,
	languages: payload.languages,
	population: payload.population,
	countryCode: payload.cca2,
	capital: {
		city: payload.capital[0]
	}
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<amqp:publish doc:name="Publish for 25 Minutes" doc:id="50f2f7a5-d452-42c6-861f-6ec42a635f3b" config-ref="Local_RabbitMQ_AMQP_Config" exchangeName="country.exchange" deliveryMode="PERSISTENT" createFallbackExchange="true">
				<amqp:fallback-exchange-definition removalStrategy="UNUSED" type="TOPIC" />
				<amqp:routing-keys>
					<amqp:routing-key value="country.weather.updated" />
				</amqp:routing-keys>
				<amqp:message>
					<amqp:properties contentType="application/json" expiration="25" expirationTimeUnit="MINUTES" />
				</amqp:message>
			</amqp:publish>
		</foreach>
	</sub-flow>
	<sub-flow name="getCountryWeatherFromDB" doc:id="862b32ff-9330-4c8d-9b6f-07f80888d2f0" >
		<set-variable value='#[attributes.queryParams.country default ""]' doc:name="queryParam" doc:id="7b976295-1134-4bea-ba83-cc2856d12ccc" variableName="queryParam" />
		<http:request doc:name="GET Country Weather" doc:id="f9fcb6c8-669e-4835-bb69-deb2ab6f4cac" config-ref="HTTP_Domain_Request_config" path="/a-messaging-sa/api/v1/country-weather" responseTimeout="30000" >
			<http:query-params ><![CDATA[#[output application/java
---
{
	"country" : vars.queryParam
}]]]></http:query-params>
		</http:request>
	</sub-flow>
	<sub-flow name="publishCountryWeatherSingleQueue" doc:id="836bce5d-0340-4696-b548-f923cc9f5a4c" >
		<http:request doc:name="get Countries" doc:id="db36f8dd-6311-41bc-b6a7-911426055b57" config-ref="HTTP_Domain_Request_config" path="${http.requester.basePath}/countries"/>
		<parallel-foreach doc:name="Parallel For Each" doc:id="d81810b6-b6c2-42af-848e-498c29a952f2" collection="#[payload]">
			<set-variable value="#[payload]" doc:name="countryData" doc:id="5f18548a-0538-4e53-9478-08871cd6bfd1" variableName="countryData"/>
			<set-variable value="#[payload.capital[0]]" doc:name="city" doc:id="4e0d8a61-4de9-4873-bb47-1d33c9d60104" variableName="city"/>
			<http:request doc:name="get Weather" doc:id="0e9cd925-d801-4cff-9662-1edfc3f0d7ef" path="${http.requester.basePath}/weather" config-ref="HTTP_Domain_Request_config">
				<http:query-params ><![CDATA[#[output application/java
---
{
	"city" : vars.city
}]]]></http:query-params>
			</http:request>
			<ee:transform doc:name="MAP Country and Weather">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var countryData = vars.countryData
var weatherData = payload
---
{
    country: countryData.name.common,
	region: countryData.region,
	subregion: countryData.subregion,
	currencies: countryData.currencies,
	languages: countryData.languages,
	countryCode: countryData.cca2,
	population: countryData.population,
	capital: {
		city: countryData.capital[0],
		longitude: weatherData.coord.lon,
		latitude: weatherData.coord.lat,
		weatherConditions: {
			visibility: weatherData.visibility,
			temperature: {
				current: weatherData.main.temp,
				max: weatherData.main.temp_max,
				min: weatherData.main.temp_min
			}
		},
		sunrise: weatherData.sys.sunrise,
		sunset: weatherData.sys.sunset
	}
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			<amqp:publish doc:name="Publish for 2 Minutes" doc:id="7d4a0587-bcff-41f5-8faa-248f134b816f" config-ref="Local_RabbitMQ_AMQP_Config" exchangeName="country.exchange" deliveryMode="PERSISTENT" createFallbackExchange="true">
				<amqp:fallback-exchange-definition removalStrategy="UNUSED" type="TOPIC" />
				<amqp:routing-keys >
					<amqp:routing-key value="country.weather.updated" />
				</amqp:routing-keys>
				<amqp:message >
					<amqp:properties expirationTimeUnit="MINUTES" expiration="2" contentType="application/json"/>
				</amqp:message>
			</amqp:publish>
		</parallel-foreach>
	</sub-flow>
	<sub-flow name="publishCountryWeatherTwoQueues" doc:id="fec88438-e2f0-44b8-af68-95a5085105d8" >
		<http:request doc:name="get Countries" doc:id="c799629b-8baf-4d70-ad0d-8874842d18d4" config-ref="HTTP_Domain_Request_config" path="${http.requester.basePath}/countries" />
		<parallel-foreach doc:name="Parallel For Each" doc:id="afcc7d8e-db7e-4191-8a81-c54eec700ee7" collection="#[payload]" >
			<set-variable value="#[lower(payload.cca2)]" doc:name="countryCode" doc:id="590619fd-a4cc-461e-ba8f-fed892c575e0" variableName="countryCode"/>
			<set-variable value="#[payload]" doc:name="countryData" doc:id="9fbf6148-184a-440b-bbad-e1ec5b529430" variableName="countryData" />
			<set-variable value="#[payload.capital[0]]" doc:name="city" doc:id="98506acb-e818-4976-9d7d-7ad50941243a" variableName="city" />
			<http:request doc:name="get Weather" doc:id="0c2fd470-6819-47b5-a98c-771545af5cd2" config-ref="HTTP_Domain_Request_config" path="${http.requester.basePath}/weather" >
				<http:query-params ><![CDATA[#[output application/java
---
{
	"city" : vars.city
}]]]></http:query-params>
			</http:request>
			<ee:transform doc:name="MAP Country and Weather" doc:id="546e7a7d-1729-4af6-8a92-7ee1b662d07b" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var countryData = vars.countryData
var weatherData = payload
---
{
    country: countryData.name.common,
	region: countryData.region,
	subregion: countryData.subregion,
	currencies: countryData.currencies,
	languages: countryData.languages,
	countryCode: countryData.cca2,
	population: countryData.population,
	capital: {
		city: countryData.capital[0],
		longitude: weatherData.coord.lon,
		latitude: weatherData.coord.lat,
		weatherConditions: {
			visibility: weatherData.visibility,
			temperature: {
				current: weatherData.main.temp,
				max: weatherData.main.temp_max,
				min: weatherData.main.temp_min
			}
		},
		sunrise: weatherData.sys.sunrise,
		sunset: weatherData.sys.sunset
	}
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<amqp:publish doc:name="Publish for 2 Minutes" doc:id="875bb6b8-7bd3-4d64-a6b6-9fb92331b260" config-ref="Local_RabbitMQ_AMQP_Config" exchangeName="country.exchange" deliveryMode="PERSISTENT" createFallbackExchange="true">
				<amqp:fallback-exchange-definition removalStrategy="UNUSED" type="TOPIC" />
				<amqp:routing-keys>
					<amqp:routing-key value='#[vars.countryCode ++ ".weather.updated"]' />
				</amqp:routing-keys>
				<amqp:message>
					<amqp:properties contentType="application/json" expiration="4" expirationTimeUnit="MINUTES" />
				</amqp:message>
			</amqp:publish>
		</parallel-foreach>
	</sub-flow>	
</mule>
